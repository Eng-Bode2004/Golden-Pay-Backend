# ---------------------------------------------------------------------------
# Golden Pay - Identity & Access service
# Copy this file to `.env` and replace every secret before deploying.
# Bun loads `.env` automatically; `.env` is git-ignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL
# The service creates its own tables on start (Config/schema.sql is idempotent).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://golden_pay:CHANGE_ME@127.0.0.1:5432/golden_pay_identity

# ---------------------------------------------------------------------------
# Secrets - REQUIRED in production (the service refuses to start without them)
# Generate each value with: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=golden-pay-identity
JWT_AUDIENCE=golden-pay-clients

# Exactly 32 bytes, base64 (openssl rand -base64 32) or 64-char hex.
NATIONAL_ID_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# HMAC key used to fingerprint national IDs for duplicate detection.
NATIONAL_ID_HMAC_SECRET=replace-with-at-least-32-random-characters

# Pepper applied to refresh tokens before they are stored as hashes.
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Token lifetimes (seconds)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SIGNUP_TOKEN_TTL_SECONDS=1200
BIOMETRIC_CHALLENGE_TTL_SECONDS=90

# ---------------------------------------------------------------------------
# Employee numbers
# ---------------------------------------------------------------------------
EMPLOYEE_NUMBER_PREFIX=GP
EMPLOYEE_NUMBER_PAD=6

# ---------------------------------------------------------------------------
# Uploads
# All uploaded national-ID images are stored under the repository Storage tree.
# Default: <repo>/Storage/identity-access
# ---------------------------------------------------------------------------
UPLOAD_DIR=../../Storage/identity-access
MAX_UPLOAD_BYTES=8388608
MAX_JSON_BYTES=1048576

# ---------------------------------------------------------------------------
# Login protection
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# When true, existing-employee signup must match the HR record's full name and
# phone number in addition to the national ID.
STRICT_EMPLOYEE_VERIFICATION=true

# Comma-separated list of allowed browser origins. `*` allows any origin.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Dashboard invitations (sent from goldenpayservices@gmail.com)
# Gmail requires an App Password in SMTP_PASS, not the dashboard login password.
# ---------------------------------------------------------------------------
DASHBOARD_PUBLIC_URL=http://127.0.0.1:4100
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=goldenpayservices@gmail.com
SMTP_PASS=
MAIL_FROM=Golden Pay Services <goldenpayservices@gmail.com>

# Cloud file storage (S3-compatible). Leave STORAGE_BUCKET empty to keep files in UPLOAD_DIR.
# The same settings are also read as S3_BUCKET, S3_REGION, S3_ENDPOINT, S3_FOLDER,
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY (the names Thalmet Cloud uses).
STORAGE_BUCKET=
STORAGE_REGION=us-east-2
STORAGE_ENDPOINT=https://s3.us-east-2.amazonaws.com
STORAGE_FOLDER=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
